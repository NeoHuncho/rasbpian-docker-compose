# Host port and public URL.
APP_PORT=6060
APP_URL=http://your-server-ip:6060

# Host folder mounted as /books inside BookOrbit.
BOOKS_HOST_PATH=/mainDrive/media/books

# UID/GID that own the library files on the server.
PUID=1000
PGID=1000

# Database credentials. Replace the password before starting the stack.
POSTGRES_USER=bookorbit
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=bookorbit

# App secrets. Generate unique values before starting the stack.
JWT_SECRET=replace-with-a-long-random-secret
SETUP_BOOTSTRAP_TOKEN=replace-with-a-one-time-setup-token

# Runtime and library settings.
TZ=Europe/Paris
NODE_MAX_OLD_SPACE_SIZE=2048
LIBRARY_BROWSE_ROOT=/books

# Optional: set this only when using a different external frontend origin.
# CLIENT_URL=https://bookorbit.example.com
